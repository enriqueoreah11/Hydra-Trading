# ====== cTrader Open API (crea tu app en https://openapi.ctrader.com/apps) ======
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con el Redirect URI registrado en tu app de cTrader
CTRADER_REDIRECT_URI=https://TU-DOMINIO/oauth/callback
# demo | live  (empieza SIEMPRE en demo)
CTRADER_ENV=demo
# Lo obtienes tras el OAuth en /oauth/callback (ctidTraderAccountId)
CTRADER_ACCOUNT_ID=0

# ====== Anthropic ======
ANTHROPIC_API_KEY=
MODEL=claude-opus-4-8

# ====== Universo y cadencia ======
SYMBOLS=EURUSD,XAUUSD
TIMEFRAME=M15
ANALYSIS_INTERVAL_MIN=15
OVERNIGHT_INTERVAL_MIN=30
REVIEW_HOUR_UTC=21

# ====== Limites duros de riesgo (el Arquitecto NO puede tocarlos) ======
# true = modo papel: registra las ordenes en el diario pero NO las envia
DRY_RUN=true
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=3
MIN_CONFIDENCE=65
MIN_RISK_REWARD=1.5
EQUITY_FLOOR_PCT=80.0

# ====== Sentinel — bloqueo por noticias (calendario economico) ======
ENABLE_NEWS=true
NEWS_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# High | Medium | Low  (impacto minimo que bloquea nuevas entradas)
NEWS_IMPACT_MIN=High
NEWS_BLACKOUT_BEFORE_MIN=30
NEWS_BLACKOUT_AFTER_MIN=15
NEWS_REFRESH_MIN=180

# ====== Watchdog + notificaciones por Telegram ======
# Crea un bot con @BotFather y pon aqui el token; deja vacio para desactivar avisos.
TELEGRAM_BOT_TOKEN=
# Tu chat id (habla con @userinfobot para obtenerlo)
TELEGRAM_CHAT_ID=
WATCHDOG_INTERVAL_MIN=5
DATA_STALE_ALERT_MIN=20
ERROR_BURST_THRESHOLD=5
HEARTBEAT_HOUR_UTC=8

# ====== Auditor / reconciliador ======
ENABLE_AUDITOR=true
AUDITOR_INTERVAL_MIN=20
AUTO_HALT_ON_DISCREPANCY=true

# ====== Validador de playbook (backtest ligero antes de activar cambios) ======
VALIDATE_PLAYBOOK=true
BACKTEST_BARS=400
# nº de puntos de decision muestreados por simbolo (mayor = mas coste de LLM)
BACKTEST_SAMPLES=12
BACKTEST_HORIZON_BARS=24

# ====== Riesgo de portafolio / correlacion ======
ENABLE_PORTFOLIO_CHECK=true
MAX_CURRENCY_EXPOSURE_PCT=2.0
MAX_CORRELATION=0.7

# ====== Web ======
WEB_HOST=0.0.0.0
WEB_PORT=8000
# si lo defines, /halt y /resume requieren ?token=...
DASHBOARD_TOKEN=

# ====== Almacenamiento (usa un volumen persistente en la nube) ======
DATA_DIR=./data

# ====== Memoria en Obsidian ======
# Vacio = la memoria vive dentro de la app (data/vault) y solo se ve bajando el
# .zip. Con la ruta de TU vault, las notas se escriben ahi y las ves en Obsidian
# segun se crean. La carpeta tiene que existir: no se crea nunca.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_FOLDER=Hydra
# del resto del vault solo se leen las notas marcadas con esta etiqueta
OBSIDIAN_TAG=hydra

# ====== Oidos (voz -> texto) ======
# Whisper local dentro de Voicebox: el audio no sale del Mac y no hace falta clave
STT_ENABLED=true
STT_MODEL=whisper-turbo
STT_TIMEOUT_S=60

# ====== Macro (tipos, VIX, dolar, posicionamiento) ======
# clave gratuita en fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
MACRO_ENABLED=true

# ====== Como decide que operar ======
# "manual": el playbook lo escribes tu (o lo evoluciona el Arquitecto).
# "auto":   lo escribe la MEDICION: cada dia prueba las estrategias sobre tu
#           historico, puntua fuera de muestra y con coste, y solo opera lo que
#           sobrevive. Lo que deja de funcionar desaparece solo.
PLAYBOOK_MODE=manual
DESCUBRIR_STEPS=3
DESCUBRIR_HORIZON=60
DESCUBRIR_SPLIT=0.7
# spread + comision estimados en multiplos de R. A cero, el backtest miente hacia arriba
COSTE_R=0.05

# ====== Tu estrategia (la que le enseñas tu) ======
# Con esto activo, el sistema aplica TU estrategia al pie de la letra en vez del
# playbook. Se ensena a trozos desde Sistema -> Estrategia, o en tu Obsidian.
ESTRATEGIA_ACTIVA=false
ESTRATEGIA_LABEL=50cal
# Carpeta con los manuales del curso. La app corre en TU Mac y puede leer iCloud,
# pero solo lo DESCARGADO: un archivo que solo vive en la nube no se puede abrir.
ESTRATEGIA_DIR=

# ====== Cuando analiza ======
# "continua" = cada ANALYSIS_INTERVAL_MIN. "sesiones" = solo los dias de abajo, y
# deja ordenes PENDIENTES en las zonas que caducan en la siguiente sesion.
CADENCIA=continua
SESION_DIAS=sun,wed
SESION_HORA_UTC=20
SESION_MAX_ORDENES=6

# ====== Quien toca la cuenta ======
# El modelo razona; el codigo opera. Con esto activo, los stops de las posiciones
# abiertas los calcula gestion.py con aritmetica (precio, entrada, ATR) y no un
# numero salido de un modelo de lenguaje.
EJECUCION_DETERMINISTA=true
GESTION_BE_EN_R=1.0
GESTION_TRAIL_ATR=2.0
GESTION_MIN_ATR=0.8
# Un "cerrar" del modelo avisa, no cierra: cerrar por una lectura equivocada mata
# una operacion que iba bien, y eso no se deshace.
PERMITIR_CIERRE_POR_LLM=false
